rules_version = '2';

// Regras de acesso. Perfis: Torcedor (sem login), Participante (login +
// vínculo aprovado na categoria) e Organização (quem tem documento em
// organizacao/{uid}, criado à mão no console do Firebase).
//
// Cada categoria é uma temporada (temporadas/master-2027, /livre-2027,
// /super-master-2027). O campo `temporadas` em organizacao/{uid} (lista de
// ids) diz quais categorias a conta organiza: ela só altera essas. No
// primeiro acesso, o próprio organizador informa a categoria no app; trocar
// depois (ou dar mais de uma) é feito aqui no console.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function organizacao() {
      return logado() && exists(/databases/$(database)/documents/organizacao/$(request.auth.uid));
    }
    function organizacaoDe(t) {
      return organizacao()
        && t in get(/databases/$(database)/documents/organizacao/$(request.auth.uid)).data.get('temporadas', []);
    }

    // Lista de quem é da Organização: só leitura do próprio registro.
    // O organizador lê o próprio registro e informa a categoria uma única vez
    // (só se ainda não tiver `temporadas`, e só uma categoria).
    match /organizacao/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow update: if logado() && request.auth.uid == uid
        && !('temporadas' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['temporadas'])
        && request.resource.data.temporadas is list
        && request.resource.data.temporadas.size() == 1
        && request.resource.data.temporadas[0] in ['master-2027', 'super-master-2027', 'livre-2027'];
      allow create, delete: if false;
    }

    match /temporadas/{t} {
      allow read: if true;
      allow write: if organizacaoDe(t);

      // Times: a Organização da categoria grava tudo; o dirigente aprovado do
      // time só troca o escudo (nome, sigla e cor continuam os mesmos).
      match /times/{id} {
        function vinculo() {
          return /databases/$(database)/documents/temporadas/$(t)/vinculos/$(request.auth.uid);
        }
        function dirigenteDoTime() {
          return logado() && exists(vinculo())
            && get(vinculo()).data.status == 'aprovado'
            && get(vinculo()).data.papel == 'dirigente'
            && get(vinculo()).data.timeId == id;
        }
        allow read: if true;
        allow create: if organizacaoDe(t) || (dirigenteDoTime()
          && request.resource.data.keys().hasOnly(['nome', 'sigla', 'cor', 'escudo']));
        allow update: if organizacaoDe(t) || (dirigenteDoTime()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['escudo']));
        allow delete: if organizacaoDe(t);
      }
      match /partidas/{id}  { allow read: if true; allow write: if organizacaoDe(t); }
      match /decisoes/{id}  { allow read: if true; allow write: if organizacaoDe(t); }
      match /ajustes/{id}   { allow read: if true; allow write: if organizacaoDe(t); }

      // Elencos: nome e número são públicos (aparecem na súmula e na lista de
      // suspensos); só a Organização da categoria grava.
      match /pessoas/{id}   { allow read: if true; allow write: if organizacaoDe(t); }

      // Financeiro e documentos: só a Organização da categoria.
      // Quitações: quem tem login lê (para ver a própria situação); só a
      // Organização registra.
      match /pagamentos/{id}    { allow read: if logado(); allow write: if organizacaoDe(t); }
      match /movimentacoes/{id} { allow read, write: if organizacaoDe(t); }

      // Vínculo da conta nesta categoria. O próprio usuário lê e pede (ou
      // refaz) o vínculo, sempre como pendente; só a Organização da categoria
      // aprova ou recusa.
      match /vinculos/{uid} {
        function proprio() { return logado() && request.auth.uid == uid; }
        function pedidoValido() { return request.resource.data.status == 'pendente'; }
        allow read: if organizacaoDe(t) || proprio();
        allow create, update: if organizacaoDe(t) || (proprio() && pedidoValido());
        allow delete: if organizacaoDe(t) || proprio();
      }
    }

    // Cadastro da conta (nome e e-mail). Os vínculos ficam em cada categoria
    // (temporadas/{t}/vinculos/{uid}).
    match /usuarios/{uid} {
      function cadastroValido() {
        return request.resource.data.perfil == 'participante'
          && !('vinculo' in request.resource.data);
      }
      allow read: if organizacao() || (logado() && request.auth.uid == uid);
      allow create, update: if logado() && request.auth.uid == uid && cadastroValido();
      allow delete: if organizacao() || (logado() && request.auth.uid == uid);
    }
  }
}
