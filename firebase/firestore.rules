rules_version = '2';

// Regras de acesso. Perfis: Torcedor (sem login), Participante (login +
// vínculo aprovado) e Organização (quem tem documento em organizacao/{uid},
// criado à mão no console do Firebase).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function organizacao() {
      return logado() && exists(/databases/$(database)/documents/organizacao/$(request.auth.uid));
    }

    // Lista de quem é da Organização: só leitura do próprio registro.
    match /organizacao/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Dados públicos: qualquer pessoa lê; só a Organização escreve.
    match /clubes/{id} {
      allow read: if true;
      allow write: if organizacao();
    }

    match /temporadas/{t} {
      allow read: if true;
      allow write: if organizacao();

      match /times/{id}     { allow read: if true; allow write: if organizacao(); }
      match /partidas/{id}  { allow read: if true; allow write: if organizacao(); }
      match /decisoes/{id}  { allow read: if true; allow write: if organizacao(); }
      match /ajustes/{id}   { allow read: if true; allow write: if organizacao(); }
      match /publico/{doc}  { allow read: if true; allow write: if organizacao(); }

      // Nomes dos elencos: participantes logados e Organização.
      match /pessoas/{id}   { allow read: if logado(); allow write: if organizacao(); }

      // Financeiro e documentos: só a Organização.
      match /pagamentos/{id}    { allow read, write: if organizacao(); }
      match /movimentacoes/{id} { allow read, write: if organizacao(); }
      match /privado/{doc}      { allow read, write: if organizacao(); }
    }

    // Cada usuário lê o próprio cadastro e pede (ou refaz) o vínculo, sempre
    // como pendente. Só a Organização aprova ou recusa.
    match /usuarios/{uid} {
      function pedidoValido() {
        return request.resource.data.perfil == 'participante'
          && request.resource.data.vinculo.status == 'pendente';
      }
      allow read: if organizacao() || (logado() && request.auth.uid == uid);
      allow create: if logado() && request.auth.uid == uid && pedidoValido();
      allow update: if organizacao() || (logado() && request.auth.uid == uid && pedidoValido());
      allow delete: if organizacao() || (logado() && request.auth.uid == uid);

      match /situacao/{doc} {
        allow read: if organizacao() || (logado() && request.auth.uid == uid);
        allow write: if organizacao();
      }
    }
  }
}
